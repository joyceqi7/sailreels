# Server-side file: lives at /opt/sailreels/apps/api/.env on tt-shop-prod.
# It is gitignored, so `git pull` never updates it — if a variable is renamed in code, edit it here
# by hand too, or the app silently falls back to a default.

ENV=staging

# Which app this stack serves. One stack per app, each in its own /opt/<app> with its own compose project
# (-p <app>), domain and database. The values below are the SailReels stack. Copy this file per app and
# change only that app's identity, origins, credentials and BytePlus space. API_ALIAS must be unique per
# stack and match that app's Caddy site.
#   SailReels:  /opt/sailreels   APP_NAME=SailReels   LEGAL_ENTITY=sailson_sg  API_ALIAS=sailreels-api
#               https://sailreels.sailson.com/api/v1/webhooks/tiktok
#   SailTale:   /opt/sailtale    APP_NAME=SailTale    LEGAL_ENTITY=sailson_hk  API_ALIAS=sailtale-api
#               https://sailtale.sailson.com/api/v1/webhooks/tiktok
#   SailShort:  /opt/sailshort   APP_NAME=SailShort   LEGAL_ENTITY=bang_us     API_ALIAS=sailshort-api
#               https://sailshort.sailson.com/api/v1/webhooks/tiktok
#               TIKTOK_CLIENT_KEY=mn_example_client_key  (secret stays TIKTOK_CLIENT_SECRET= on the server only)
#               Caddy site: deploy/caddy-snippet-sailshort.conf
#               Web build: cd apps/web && npm run build:sailshort
# Do not point SailShort at another app's database, client secret, or reviewed albums.
APP_NAME=SailReels
LEGAL_ENTITY=sailson_sg
API_ALIAS=sailreels-api
# iaa = rewarded ads only (Beans/subscription orders get 403). hybrid = Beans + subscriptions + ads.
# Must match the web build's VITE_MONETIZATION in apps/web/.env.<app>. Unset means iaa.
MONETIZATION_MODE=iaa

# Compose injects DATABASE_URL/REDIS_URL for the containers; these are for running commands
# directly on the host (migrations, scripts/media.py). Ports stay unpublished.
DATABASE_URL=postgresql+asyncpg://sailreels:CHANGE_ME@db:5432/sailreels
REDIS_URL=redis://redis:6379/0

# Postgres password used by docker-compose.prod.yml. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Session cookie signing. Must be >= 32 chars; the app refuses to start otherwise when ENV != local.
# Generate: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

TIKTOK_CLIENT_KEY=mn_example_client_key
TIKTOK_CLIENT_SECRET=CHANGE_ME

# BytePlus VOD — fill once the account and space exist and AK/SK are bound in TTOP.
BYTEPLUS_ACCOUNT_ID=
BYTEPLUS_SPACE_NAME=
BYTEPLUS_REGION=ap-southeast-1

# Staging: keep token refresh paused until login is verified end to end, then flip to true
# and restart worker + beat.
TOKEN_REFRESH_ENABLED=false
TOKEN_REFRESH_INTERVAL_SECONDS=300
TOKEN_REFRESH_WINDOW_SECONDS=1800
TOKEN_REFRESH_BATCH_SIZE=200

# Webhook retry sweep: always on (not gated on TOKEN_REFRESH_ENABLED).
WEBHOOK_RETRY_INTERVAL_SECONDS=60
WEBHOOK_RETRY_BATCH_SIZE=100

PUBLIC_API_ORIGIN=https://sailreels.sailson.com

# Staging: sandbox orders should grant entitlements so unlock flows are testable.
# MUST be false in the real production deployment.
ALLOW_SANDBOX_ENTITLEMENTS=true

# The mini runs inside TikTok's WebView; only the platform origin needs CORS.
CORS_ORIGINS=["https://sailreels.sailson.com","https://www.tiktok.com"]
