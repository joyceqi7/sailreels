# Example only. Wayne replaces domain/cert paths and deploys when real integration resumes.
# api must resolve to the backend container/service. Do not rewrite the webhook body.
server {
    listen 443 ssl;
    server_name api-staging.example.com;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    client_max_body_size 1m;
    location / {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header TikTok-Signature $http_tiktok_signature;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
