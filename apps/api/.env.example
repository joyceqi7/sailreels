ENV=local
DATABASE_URL=postgresql+asyncpg://sailreels:sailreels@localhost:55440/sailreels
REDIS_URL=redis://localhost:56390/0
CELERY_BROKER_URL=
# Real integration is paused. Explicitly enable only after credentials and staging are verified.
TOKEN_REFRESH_ENABLED=false
TOKEN_REFRESH_INTERVAL_SECONDS=300
TOKEN_REFRESH_WINDOW_SECONDS=1800
TOKEN_REFRESH_BATCH_SIZE=200
# Origin only, e.g. https://api-staging.example.com; leave blank until deployed.
PUBLIC_API_ORIGIN=

# Webhook retry sweep. Always scheduled (not gated on TOKEN_REFRESH_ENABLED): the webhook handler
# answers 200 even when applying an event fails, so an unretried payment would never be fulfilled.
WEBHOOK_RETRY_INTERVAL_SECONDS=60
WEBHOOK_RETRY_BATCH_SIZE=100

# Dev Portal -> App -> Credentials. client_secret stays server-side only.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# BytePlus VOD (filled after account + space are created and bound in TTOP)
BYTEPLUS_ACCOUNT_ID=
BYTEPLUS_SPACE_NAME=
BYTEPLUS_REGION=ap-southeast-1

SESSION_SECRET=change-me
# iaa = rewarded ads only (Beans/subscription orders get 403); hybrid = Beans + subscriptions + ads.
# Local dev keeps hybrid so every flow stays testable; unset means iaa.
MONETIZATION_MODE=hybrid

# Must be false in prod: sandbox orders never grant real entitlements
ALLOW_SANDBOX_ENTITLEMENTS=true
# Approved production Tier IDs, supplied by Wayne after SKU setup. JSON array, not comma-separated text.
SUBSCRIPTION_TIER_IDS=[]
# Explicit opt-in for the four documented sandbox plans. Ignored in ENV=prod.
SUBSCRIPTION_SANDBOX_ENABLED=false
CORS_ORIGINS=["http://localhost:5177"]
# The mini page is served by TikTok, so its origin must be allowed too. Defaults to the platform's
# 4 domains (tiktok-minis.us/.com/.eu, tiktokminis.us) plus any sailson.com subdomain and localhost.
# Leave blank to use the default in app/core/config.py; only override to narrow it.
CORS_ORIGIN_REGEX=
